<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_ko_print_agent_list" model="ir.ui.view">
        <field name="name">ko.print.agent.list</field>
        <field name="model">ko.print.agent</field>
        <field name="arch" type="xml">
            <list string="Print Agents">
                <field name="name"/>
                <field name="is_online" widget="boolean_toggle" readonly="1"/>
                <field name="last_seen"/>
                <field name="agent_version"/>
                <field name="last_ip" optional="hide"/>
                <field name="job_count"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_ko_print_agent_form" model="ir.ui.view">
        <field name="name">ko.print.agent.form</field>
        <field name="model">ko.print.agent</field>
        <field name="arch" type="xml">
            <form string="Print Agent">
                <header>
                    <button name="action_regenerate_token" type="object"
                            string="Regenerate token"
                            class="btn-secondary"
                            groups="point_of_sale.group_pos_manager"
                            confirm="The shop agent will stop working until it is reconfigured with the new token. Continue?"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_jobs" type="object" class="oe_stat_button"
                                icon="fa-print">
                            <field name="job_count" widget="statinfo" string="Queued"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Front counter PC"/></h1>
                    </div>
                    <field name="active" invisible="1"/>
                    <group>
                        <group string="Status">
                            <field name="is_online"/>
                            <field name="last_seen"/>
                            <field name="agent_version"/>
                            <field name="last_ip"/>
                        </group>
                        <group string="Configuration">
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="token" groups="point_of_sale.group_pos_manager"
                                   widget="CopyClipboardChar"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert"
                         groups="point_of_sale.group_pos_manager">
                        Copy the token into the shop agent configuration file. It is a
                        password: anyone holding it can read this shop's print jobs.
                        The agent counts as online while it has pinged within the last
                        20 seconds.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ko_print_agent" model="ir.actions.act_window">
        <field name="name">Print Agents</field>
        <field name="res_model">ko.print.agent</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Register the PC that prints for this shop
            </p><p>
                The print agent is a small program running on a PC in the shop. It asks
                Odoo for print jobs and sends them to the thermal printers on the local
                network, so a POS served over HTTPS can still print silently.
            </p>
        </field>
    </record>

    <menuitem id="menu_ko_print_agent"
              name="Print Agents"
              parent="point_of_sale.menu_point_config_product"
              action="action_ko_print_agent"
              sequence="70"/>

</odoo>
