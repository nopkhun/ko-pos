<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_ko_cloud_print" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.ko.cloud.print</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <block id="pos_connected_devices_section" position="inside">
                <setting id="ko_print_agent" string="KO Print Agent"
                         help="Print receipts silently on an ESC/POS network printer through the shop print agent">
                    <div class="content-group mt16">
                        <div class="row">
                            <label string="Receipt Printer" for="pos_ko_receipt_printer_id"
                                   class="col-lg-5 o_light_label"/>
                            <field name="pos_ko_receipt_printer_id"
                                   options="{'no_create_edit': True}"/>
                        </div>
                        <div class="row" invisible="not pos_ko_receipt_printer_id">
                            <label string="Open Cash Drawer" for="pos_ko_cashdrawer"
                                   class="col-lg-5 o_light_label"/>
                            <field name="pos_ko_cashdrawer"/>
                        </div>
                    </div>
                    <div class="text-muted">
                        Kitchen tickets are not configured here — they keep using the
                        preparation printers under "Preparation".
                    </div>
                </setting>
            </block>
        </field>
    </record>

</odoo>
