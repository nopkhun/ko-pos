<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_payment_method_view_form_inherit_beam_bolt" model="ir.ui.view">
        <field name="name">pos.payment.method.form.inherit.beam.bolt</field>
        <field name="model">pos.payment.method</field>
        <field name="inherit_id" ref="point_of_sale.pos_payment_method_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='use_payment_terminal']" position="after">
                <field name="beam_merchant_id" invisible="use_payment_terminal != 'beam_bolt'" required="use_payment_terminal == 'beam_bolt'"/>
                <field name="beam_api_key" invisible="use_payment_terminal != 'beam_bolt'" required="use_payment_terminal == 'beam_bolt'" password="True"/>
                <field name="beam_bolt_connection_id" invisible="use_payment_terminal != 'beam_bolt'" required="use_payment_terminal == 'beam_bolt'"/>
                <field name="beam_payment_method_type" invisible="use_payment_terminal != 'beam_bolt'"/>
                <field name="beam_expiry_sec" invisible="use_payment_terminal != 'beam_bolt'"/>
                <field name="beam_test_mode" invisible="use_payment_terminal != 'beam_bolt'"/>
            </xpath>
        </field>
    </record>
</odoo>
