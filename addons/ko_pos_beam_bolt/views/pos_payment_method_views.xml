<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_payment_method_view_form_inherit_beam_bolt" model="ir.ui.view">
        <field name="name">pos.payment.method.form.inherit.beam.bolt</field>
        <field name="model">pos.payment.method</field>
        <field name="inherit_id" ref="point_of_sale.pos_payment_method_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='use_payment_terminal']" position="after">
                <field name="beam_merchant_id" invisible="use_payment_terminal != 'beam_bolt'" required="use_payment_terminal == 'beam_bolt'"/>
                <field name="beam_api_key" invisible="use_payment_terminal != 'beam_bolt'" required="use_payment_terminal == 'beam_bolt'" password="True"/>
                <field name="beam_pairing_code" invisible="use_payment_terminal != 'beam_bolt' or beam_bolt_connection_id" placeholder="กรอกรหัสที่แสดงบน Beam Bolt"/>
                <field name="beam_bolt_connection_id" invisible="use_payment_terminal != 'beam_bolt'"/>
                <field name="beam_device_id" invisible="use_payment_terminal != 'beam_bolt'"/>
                <field name="beam_connection_environment" invisible="use_payment_terminal != 'beam_bolt' or not beam_bolt_connection_id"/>
                <field name="beam_connection_status" invisible="use_payment_terminal != 'beam_bolt'" widget="badge"
                       decoration-success="beam_connection_status == 'connected'"
                       decoration-danger="beam_connection_status == 'invalid'"/>
                <field name="beam_last_checked_at" invisible="use_payment_terminal != 'beam_bolt' or not beam_last_checked_at"/>
                <field name="beam_payment_method_type" invisible="use_payment_terminal != 'beam_bolt'"/>
                <field name="beam_installment_period" invisible="use_payment_terminal != 'beam_bolt' or beam_payment_method_type != 'CARD_INSTALLMENTS'" required="use_payment_terminal == 'beam_bolt' and beam_payment_method_type == 'CARD_INSTALLMENTS'"/>
                <field name="beam_installment_issuer_group" invisible="use_payment_terminal != 'beam_bolt' or beam_payment_method_type != 'CARD_INSTALLMENTS'" required="use_payment_terminal == 'beam_bolt' and beam_payment_method_type == 'CARD_INSTALLMENTS'"/>
                <field name="beam_expiry_sec" invisible="use_payment_terminal != 'beam_bolt'"/>
                <field name="beam_test_mode" invisible="use_payment_terminal != 'beam_bolt'"/>
                <div class="oe_button_box" name="beam_bolt_actions" invisible="use_payment_terminal != 'beam_bolt'">
                    <button name="action_beam_pair" type="object" string="เชื่อมต่อเครื่อง" class="btn-primary"
                            invisible="beam_bolt_connection_id" groups="point_of_sale.group_pos_manager"/>
                    <button name="action_beam_check_connection" type="object" string="ตรวจสอบการเชื่อมต่อ" class="btn-secondary"
                            invisible="not beam_bolt_connection_id" groups="point_of_sale.group_pos_manager"/>
                    <button name="action_beam_disconnect" type="object" string="ยกเลิกการเชื่อมต่อ" class="btn-outline-danger"
                            invisible="not beam_bolt_connection_id" groups="point_of_sale.group_pos_manager"
                            confirm="เครื่อง Beam Bolt จะออกจากระบบและต้องเข้าสู่ระบบใหม่ก่อน Pair ครั้งถัดไป ต้องการดำเนินการต่อหรือไม่?"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
