            <field name="printer_type">epson_epos</field>
            <field name="epson_printer_ip">192.168.1.100</field>
            <field name="product_categories_ids" eval="[(6, 0, [ref('pos_categ_single_dish'), ref('pos_categ_main'), ref('pos_categ_dessert')])]"/>
