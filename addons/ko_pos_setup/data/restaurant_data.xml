<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Floors -->
        <record id="floor_inside" model="restaurant.floor">
            <field name="name">โซนด้านใน</field>
            <field name="sequence">1</field>
            <field name="background_color">rgb(249,250,251)</field>
        </record>
        <record id="floor_terrace" model="restaurant.floor">
            <field name="name">โซนระเบียง</field>
            <field name="sequence">2</field>
            <field name="background_color">rgb(235,245,235)</field>
        </record>

        <!-- Tables: โซนด้านใน (T1-T10) -->
        <record id="table_1" model="restaurant.table">
            <field name="floor_id" ref="floor_inside"/>
            <field name="table_number">1</field>
            <field name="seats">2</field>
            <field name="shape">square</field>
            <field name="position_h">50</field>
            <field name="position_v">50</field>
            <field name="width">80</field>
            <field name="height">80</field>
        </record>
