<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="ko_pos_thai_receipt.ReceiptHeader" t-inherit="point_of_sale.ReceiptHeader" t-inherit-mode="extension">
        <xpath expr="//img[hasclass('pos-receipt-logo')]" position="after">
            <t t-if="order.config.thai_receipt_enabled">
                <div class="text-center ko-thai-receipt-head">
                    <div class="fw-bolder" style="font-size:115%;" t-out="order.company.name"/>
                    <div style="font-size:75%;">
                        <t t-if="order.company.street" t-out="order.company.street"/>
                        <t t-if="order.company.city" t-out="' ' + order.company.city"/>
                        <t t-if="order.company.zip" t-out="' ' + order.company.zip"/>
                    </div>
                    <div style="font-size:75%;" t-if="order.company.phone">โทร. <t t-out="order.company.phone"/></div>
                    <div style="font-size:75%;" t-if="order.company.vat">เลขประจำตัวผู้เสียภาษี <t t-out="order.company.vat"/></div>
                    <div style="font-size:75%;" t-if="order.config.rd_machine_no">เลขรหัสประจำเครื่อง <t t-out="order.config.rd_machine_no"/></div>
                    <div class="fw-bolder pt-1" style="font-size:100%;">ใบกำกับภาษีอย่างย่อ</div>
                    <div style="font-size:70%;">(TAX INVOICE ABB)</div>
                </div>
            </t>
        </xpath>
        <xpath expr="//span[hasclass('ticket-name-prefix')]" position="replace">
            <span class="ticket-name-prefix">
                <t t-if="order.config.thai_receipt_enabled">เลขที่ </t>
                <t t-else="">
                    <t t-if="order.config._IS_VAT"> VAT </t>
                    Ticket
                </t>
            </span>
        </xpath>
    </t>
</templates>
