<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="ko_pos_thai_receipt.OrderReceipt" t-inherit="point_of_sale.OrderReceipt" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('pos-receipt-amount', 'receipt-total')]" position="after">
            <div t-if="order.config.thai_receipt_enabled" class="text-center" style="font-size:75%;">
                (ราคารวมภาษีมูลค่าเพิ่มแล้ว / VAT INCLUDED)
            </div>
        </xpath>
    </t>
</templates>
