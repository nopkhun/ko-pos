<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_config_form_kds" model="ir.ui.view">
        <field name="name">pos.config.form.ko.kds</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">
            <setting id="other_devices" position="before">
                <setting string="จอครัว (KDS)" help="ส่งออเดอร์ขึ้นจอครัวโดยไม่ต้องมีเครื่องพิมพ์ครัว">
                    <field name="ko_kds_enabled"/>
                    <div class="mt-2" invisible="not ko_kds_enabled">
                        <field name="ko_kds_auto_send_on_payment"/>
                        <span class="ms-2">ส่งครัวทันทีหลังชำระเงินสำเร็จ (สำหรับออเดอร์ที่คีย์แล้วจ่ายเลย)</span>
                    </div>
                    <div class="mt-2" invisible="not ko_kds_enabled">
                        <span>เตือนเมื่อออเดอร์ค้างเกิน</span>
                        <field name="ko_kds_sla_minutes" class="w-25 ms-2"/>
                        <span class="ms-2">นาที</span>
                    </div>
                </setting>
            </setting>
        </field>
    </record>

    <record id="action_kds_screen" model="ir.actions.act_url">
        <field name="name">จอครัว (KDS)</field>
        <field name="url">/kds</field>
        <field name="target">new</field>
    </record>

    <record id="view_kds_station_list" model="ir.ui.view">
        <field name="name">ko.kds.station.list</field>
        <field name="model">ko.kds.station</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="config_ids" widget="many2many_tags"
                       options="{'no_create': True}"
                       placeholder="ทุกจุดขาย"/>
                <field name="category_ids" widget="many2many_tags"
                       options="{'no_create': True}"
                       placeholder="ทุกหมวด (รับรายการที่เหลือ)"/>
                <field name="product_tmpl_ids" widget="many2many_tags"
                       options="{'no_create': True}"
                       optional="show" placeholder="เมนูเฉพาะ"/>
                <field name="color" optional="hide"/>
                <field name="is_catch_all" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_kds_station_form" model="ir.ui.view">
        <field name="name">ko.kds.station.form</field>
        <field name="model">ko.kds.station</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="เช่น ครัวร้อน, บาร์น้ำ, ครัวขนม"/></h1>
                    </div>
                    <group>
                        <group string="ขอบเขต">
                            <field name="config_ids" widget="many2many_tags"
                                   options="{'no_create': True}"
                                   placeholder="เว้นว่าง = ใช้ได้ทุกจุดขาย"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="sequence"/>
                            <field name="active"/>
                            <field name="color"/>
                        </group>
                        <group string="รายการที่ทำที่สถานีนี้">
                            <field name="category_ids" widget="many2many_tags"
                                   options="{'no_create': True}"/>
                            <field name="product_tmpl_ids" widget="many2many_tags"
                                   options="{'no_create': True}"/>
                            <field name="is_catch_all"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="status">
                        ระบบเลือกสถานีให้แต่ละรายการตามลำดับนี้: <b>เมนูเฉพาะ</b> ก่อน →
                        ถ้าไม่ตรงจึงดู <b>หมวดสินค้า</b> → ถ้ายังไม่ตรง จะตกไปที่สถานีที่ไม่ได้ระบุอะไรเลย
                        (สถานีรับรายการที่เหลือ) จึงไม่มีรายการไหนหายไปจากจอครัว
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_kds_station" model="ir.actions.act_window">
        <field name="name">สถานีครัว (KDS Stations)</field>
        <field name="res_model">ko.kds.station</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">สร้างสถานีครัวแรกของร้าน</p>
            <p>เช่น ครัวร้อน / ครัวเย็น / บาร์น้ำ / ครัวขนม แล้วผูกหมวดสินค้าหรือเมนูที่สถานีนั้นรับผิดชอบ</p>
        </field>
    </record>

    <record id="view_kds_ticket_list" model="ir.ui.view">
        <field name="name">ko.kds.ticket.list</field>
        <field name="model">ko.kds.ticket</field>
        <field name="arch" type="xml">
            <list create="false">
                <field name="create_date"/>
                <field name="name"/>
                <field name="config_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="table_name"/>
                <field name="customer_name"/>
                <field name="floor_name"/>
                <field name="pos_reference"/>
                <field name="paid" optional="show"/>
                <field name="state"/>
                <field name="ready_time"/>
                <field name="served_time"/>
                <field name="done_time" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_kds_ticket_form" model="ir.ui.view">
        <field name="name">ko.kds.ticket.form</field>
        <field name="model">ko.kds.ticket</field>
        <field name="arch" type="xml">
            <form create="false">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="config_id" readonly="1"/>
                            <field name="table_name" readonly="1"/>
                            <field name="customer_name" readonly="1"/>
                            <field name="order_type" readonly="1"/>
                            <field name="paid" readonly="1"/>
                        </group>
                        <group>
                            <field name="state" readonly="1"/>
                            <field name="tracking_number" readonly="1"/>
                            <field name="pos_reference" readonly="1"/>
                            <field name="ready_time" readonly="1"/>
                            <field name="served_time" readonly="1"/>
                        </group>
                    </group>
                    <field name="line_ids" readonly="1">
                        <list>
                            <field name="qty"/>
                            <field name="full_name"/>
                            <field name="station_id"/>
                            <field name="state"/>
                            <field name="issue_type"/>
                            <field name="issue_note"/>
                            <field name="issue_ack"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_kds_ticket" model="ir.actions.act_window">
        <field name="name">ประวัติออเดอร์ครัว</field>
        <field name="res_model">ko.kds.ticket</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_kds_screen" name="จอครัว (KDS)"
              parent="point_of_sale.menu_point_root"
              action="action_kds_screen" sequence="35"/>
    <menuitem id="menu_kds_station" name="สถานีครัว (KDS)"
              parent="point_of_sale.menu_point_config_product"
              action="action_kds_station" sequence="60"/>
    <menuitem id="menu_kds_ticket" name="ประวัติออเดอร์ครัว"
              parent="point_of_sale.menu_point_of_sale"
              action="action_kds_ticket" sequence="60"/>
</odoo>
