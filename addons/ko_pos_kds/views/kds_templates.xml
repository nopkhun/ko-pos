                            <div t-if="multi_company" class="shop-company" t-esc="cfg.company_id.name"/>
                            <div class="shop-go">เปิดจอครัว →</div>
                        </a>
                    </div>
                    <div t-if="not configs" class="empty">
                        ยังไม่มีจุดขาย (POS) ที่คุณเข้าถึงได้ — ให้ผู้ดูแลระบบสร้างจุดขายหรือเพิ่มสิทธิ์บริษัทก่อน
                    </div>
                </div>
