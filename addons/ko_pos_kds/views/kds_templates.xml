<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="kds_page" name="KDS Screen">
        <html>
            <head>
                <meta charset="utf-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no"/>
                <title>จอครัว · KO KDS</title>
                <!-- web.assets_frontend starts Odoo's asset watchdog. A raw standalone
                     page must seed the same session info as web.frontend_layout;
                     otherwise every bundle_changed event compares against an empty
                     server version and shows a false "page out of date" warning. -->
                <script type="text/javascript">
                    var odoo = {
                        csrf_token: "<t t-esc="request.csrf_token(None)"/>",
                        debug: "",
                    };
                    odoo.__session_info__ = <t t-out="json.dumps(request.env['ir.http'].get_frontend_session_info())"/>;
                </script>
                <t t-call-assets="web.assets_frontend"/>
                <style>
                    @font-face {
                        font-family: "Prompt";
                        src: url("/ko_pos_ui/static/src/fonts/Prompt-Regular.ttf") format("truetype");
                        font-weight: 400;
                    }
                    @font-face {
                        font-family: "Prompt";
                        src: url("/ko_pos_ui/static/src/fonts/Prompt-Medium.ttf") format("truetype");
                        font-weight: 500;
                    }
                    @font-face {
                        font-family: "Prompt";
                        src: url("/ko_pos_ui/static/src/fonts/Prompt-SemiBold.ttf") format("truetype");
                        font-weight: 600;
                    }
                    @font-face {
                        font-family: "Prompt";
                        src: url("/ko_pos_ui/static/src/fonts/Prompt-Bold.ttf") format("truetype");
                        font-weight: 700;
                    }

                    :root {
                        --ko-primary: oklch(0.5 0.15 190);
                        --ko-primary-dark: oklch(0.4 0.15 190);
                        --ko-primary-soft: oklch(0.5 0.15 190 / 0.07);
                        --ko-ink: #1c2426;
                        --ko-muted: #8fa0a3;
                        --ko-muted-2: #5b6d70;
                        --ko-border: #e4ebeb;
                        --ko-canvas: #f7fafa;
                        --ko-surface: #ffffff;
                        --ko-warn: #f59f00;
                        --ko-warn-text: #b06f00;
                        --ko-warn-bg: #fff7e8;
                        --ko-danger: #d9485f;
                        --ko-danger-text: #b03a4e;
                        --ko-danger-bg: #fdeef1;
                    }

                    * { box-sizing: border-box; margin: 0; padding: 0; -webkit-tap-highlight-color: transparent; }
                    body {
                        font-family: "Prompt", -apple-system, "Noto Sans Thai", sans-serif;
                        color: var(--ko-ink);
                        background: var(--ko-canvas);
                        height: 100vh;
                        display: flex;
                        flex-direction: column;
                        overflow: hidden;
                    }

                    header {
                        padding: 16px 20px 10px;
                        border-bottom: 1px solid #e8efef;
                        background: #fff;
                        flex: none;
                    }

                    .header-top {
                        display: flex;
                        justify-content: space-between;
                        align-items: baseline;
                    }

                    .header-title {
                        font-size: 21px;
                        font-weight: 600;
                    }

                    .header-title span {
                        font-weight: 400;
                        color: var(--ko-muted);
                        font-size: 13px;
                    }

                    .header-meta {
                        display: flex;
                        align-items: center;
                        gap: 12px;
                        font-size: 12px;
                        font-weight: 500;
                        color: var(--ko-muted-2);
                    }

                    .clock {
                        font-weight: 600;
                        color: var(--ko-ink);
                    }

                    .kds-tabs {
                        display: flex;
                        gap: 8px;
                        padding-top: 10px;
                    }

                    .kds-tab-btn {
                        padding: 8px 14px;
                        border-radius: 999px;
                        font-size: 13px;
                        font-weight: 600;
                        cursor: pointer;
                        border: 0;
                        color: var(--ko-muted-2);
                        background: #eef3f3;
                        transition: all 120ms ease;
                    }

                    .kds-tab-btn.active {
                        color: #fff;
                        background: var(--ko-primary);
                    }

                    .kds-subcontrols {
                        display: flex;
                        gap: 8px;
                        padding-top: 8px;
                        align-items: center;
                        flex-wrap: wrap;
                    }

                    .kds-view-toggle {
                        display: flex;
                        background: #eef3f3;
                        border-radius: 999px;
                        padding: 3px;
                    }

                    .kds-view-btn {
                        padding: 6px 13px;
                        border-radius: 999px;
                        font-size: 12.5px;
                        font-weight: 600;
                        cursor: pointer;
                        border: 0;
                        color: var(--ko-muted);
                        background: transparent;
                    }

                    .kds-view-btn.active {
                        color: var(--ko-primary-dark);
                        background: #fff;
                    }

                    .divider {
                        width: 1px;
                        height: 20px;
                        background: #e4ebeb;
                    }

                    .kds-shop-name {
                        font-size: 15px;
                        font-weight: 600;
                        color: var(--ko-primary-dark);
                        background: var(--ko-primary-soft);
                        border-radius: 999px;
                        padding: 3px 12px;
                        margin-left: 8px;
                        white-space: nowrap;
                    }

                    .kds-scope-bar {
                        display: flex;
                        align-items: center;
                        gap: 6px;
                        padding: 8px 16px;
                        border-top: 1px solid var(--ko-border);
                        overflow-x: auto;
                        white-space: nowrap;
                    }

                    .kds-scope-label {
                        font-size: 12px;
                        font-weight: 600;
                        color: var(--ko-muted);
                        margin-right: 2px;
                    }

                    .kds-scope-label:not(:first-child) { margin-left: 10px; }

                    .kds-scope-chip {
                        padding: 5px 12px;
                        border-radius: 999px;
                        font-size: 12.5px;
                        font-weight: 600;
                        text-decoration: none;
                        border: 1.5px solid var(--ko-border);
                        color: var(--ko-muted-2);
                        background: #fff;
                    }

                    .kds-scope-chip.active {
                        border-color: var(--ko-primary);
                        color: var(--ko-primary-dark);
                        background: var(--ko-primary-soft);
                    }

                    main {
                        flex: 1;
                        overflow-y: auto;
                        min-height: 0;
                        padding: 14px 16px 82px;
                        display: grid;
                        grid-template-columns: repeat(auto-fill, minmax(270px, 1fr));
                        gap: 12px;
                        align-content: start;
                        background: var(--ko-canvas);
                    }

                    .card {
                        background: #fff;
                        border-radius: 16px;
                        border: 1px solid #e8efef;
                        overflow: hidden;
                        border-top: 4px solid var(--ko-primary);
                        display: flex;
                        flex-direction: column;
                    }

                    .card.warn { border-top-color: var(--ko-warn); }
                    .card.late { border-top-color: var(--ko-danger); }
                    .card.cancelled { border-top-color: var(--ko-danger); opacity: 0.85; }

                    .card-head {
                        padding: 12px 14px 6px;
                        display: flex;
                        justify-content: space-between;
                        align-items: center;
                    }

                    .table-group {
                        display: flex;
                        align-items: center;
                        gap: 8px;
                    }

                    .table-no {
                        font-size: 15.5px;
                        font-weight: 600;
                    }

                    .badge-remake {
                        font-size: 10.5px;
                        font-weight: 700;
                        color: #fff;
                        background: var(--ko-danger);
                        border-radius: 6px;
                        padding: 2px 7px;
                    }

                    .elapsed-label {
                        font-size: 12.5px;
                        font-weight: 600;
                        color: var(--ko-primary);
                    }

                    .card.warn .elapsed-label { color: var(--ko-warn-text); }
                    .card.late .elapsed-label { color: var(--ko-danger-text); }
                    .history-meta { color: var(--ko-muted); }
                    .history-meta.late { color: var(--ko-danger-text); }

                    .sla-bar-wrap {
                        margin: 0 14px;
                        height: 4px;
                        border-radius: 99px;
                        background: #eef3f3;
                        overflow: hidden;
                    }

                    .sla-bar {
                        height: 100%;
                        border-radius: 99px;
                        background: var(--ko-primary);
                        transition: width 1s linear;
                    }

                    .card.warn .sla-bar { background: var(--ko-warn); }
                    .card.late .sla-bar { background: var(--ko-danger); }

                    .lines {
                        padding: 6px 14px 10px;
                        flex: 1;
                    }

                    .line-item {
                        padding: 5px 0;
                        border-bottom: 1px dashed #eef3f3;
                        cursor: pointer;
                    }

                    .line-item:last-child {
                        border-bottom: 0;
                    }

                    .line-top {
                        display: flex;
                        gap: 8px;
                        font-size: 14.5px;
                        align-items: center;
                    }

                    .line-qty {
                        font-weight: 700;
                        color: var(--ko-primary-dark);
                        min-width: 24px;
                    }

                    .line-name {
                        flex: 1;
                    }

                    .stn-label {
                        font-size: 10.5px;
                        font-weight: 600;
                        flex: none;
                    }

                    /* Station colour now comes from the ko.kds.station record
                       itself (inline style), so a shop can add ครัวขนม / บาร์น้ำ
                       without anyone editing this stylesheet. */
                    .stn-label.stn-none { color: var(--ko-muted); }

                    .st-chip {
                        font-size: 11px;
                        font-weight: 600;
                        padding: 3px 9px;
                        border-radius: 999px;
                        flex: none;
                    }

                    .st-cooking {
                        color: var(--ko-warn-text);
                        background: var(--ko-warn-bg);
                    }

                    .st-ready {
                        color: var(--ko-primary-dark);
                        background: var(--ko-primary-soft);
                    }

                    .st-cancelled {
                        color: var(--ko-danger-text);
                        background: var(--ko-danger-bg);
                    }

                    .line-mods {
                        font-size: 12px;
                        color: var(--ko-muted);
                        padding-left: 32px;
                    }

                    .line-note {
                        font-size: 12px;
                        color: var(--ko-warn-text);
                        padding-left: 32px;
                        font-weight: 500;
                    }

                    /* ---- kitchen → front of house alerts ---- */
                    .line-issue {
                        margin: 4px 0 2px 32px;
                        padding: 6px 10px;
                        border-radius: 8px;
                        font-size: 12px;
                        font-weight: 600;
                        color: var(--ko-danger-text);
                        background: var(--ko-danger-bg);
                        border: 1px solid var(--ko-danger);
                    }

                    .line-issue.acked {
                        color: var(--ko-muted-2);
                        background: #f2f5f5;
                        border-color: var(--ko-border);
                        font-weight: 500;
                    }

                    .line-issue-btn {
                        flex: none;
                        border: 1px solid var(--ko-danger);
                        background: #fff;
                        color: var(--ko-danger-text);
                        border-radius: 999px;
                        font-size: 11px;
                        font-weight: 600;
                        padding: 3px 9px;
                        cursor: pointer;
                        font-family: inherit;
                    }

                    .issue-backdrop {
                        position: fixed;
                        inset: 0;
                        background: rgba(15, 25, 27, 0.45);
                        display: flex;
                        align-items: flex-end;
                        justify-content: center;
                        z-index: 60;
                    }

                    .issue-sheet {
                        width: 100%;
                        max-width: 520px;
                        background: #fff;
                        border-radius: 18px 18px 0 0;
                        padding: 18px 18px 24px;
                        box-shadow: 0 -8px 30px rgba(0, 0, 0, 0.18);
                    }

                    .issue-sheet h3 {
                        font-size: 17px;
                        font-weight: 600;
                        margin-bottom: 4px;
                    }

                    .issue-sheet .issue-sub {
                        font-size: 12.5px;
                        color: var(--ko-muted-2);
                        margin-bottom: 14px;
                    }

                    .issue-opts {
                        display: grid;
                        grid-template-columns: 1fr 1fr;
                        gap: 8px;
                        margin-bottom: 12px;
                    }

                    .issue-opt {
                        padding: 12px 10px;
                        border-radius: 12px;
                        border: 1.5px solid var(--ko-border);
                        background: #fff;
                        font-size: 14px;
                        font-weight: 600;
                        font-family: inherit;
                        color: var(--ko-ink);
                        cursor: pointer;
                    }

                    .issue-opt.active {
                        border-color: var(--ko-danger);
                        color: var(--ko-danger-text);
                        background: var(--ko-danger-bg);
                    }

                    .issue-note-input {
                        width: 100%;
                        padding: 11px 12px;
                        border-radius: 10px;
                        border: 1.5px solid var(--ko-border);
                        font-size: 14px;
                        font-family: inherit;
                        margin-bottom: 12px;
                    }

                    .issue-actions {
                        display: flex;
                        gap: 8px;
                    }

                    .issue-actions button {
                        flex: 1;
                        padding: 13px;
                        border-radius: 12px;
                        border: 0;
                        font-size: 15px;
                        font-weight: 600;
                        font-family: inherit;
                        cursor: pointer;
                    }

                    .issue-cancel { background: #eef3f3; color: var(--ko-muted-2); }
                    .issue-send { background: var(--ko-danger); color: #fff; }
                    .issue-send[disabled] { opacity: 0.45; cursor: not-allowed; }

                    .card-action-btn {
                        margin: 0 14px 14px;
                        padding: 11px;
                        border-radius: 10px;
                        text-align: center;
                        font-size: 14px;
                        font-weight: 600;
                        cursor: pointer;
                        border: 0;
                        font-family: inherit;
                    }

                    .btn-start {
                        color: var(--ko-warn-text);
                        background: var(--ko-warn-bg);
                    }

                    .btn-all-ready {
                        color: var(--ko-primary-dark);
                        background: var(--ko-primary-soft);
                    }

                    .btn-waiting {
                        color: var(--ko-muted);
                        background: #f2f5f5;
                        cursor: default;
                    }

                    .btn-remake {
                        color: var(--ko-danger-text);
                        background: var(--ko-danger-bg);
                    }

                    .empty-board {
                        grid-column: 1 / -1;
                        padding: 48px 20px;
                        text-align: center;
                        color: var(--ko-muted);
                        font-size: 15px;
                    }

                    .toast-container {
                        position: fixed;
                        left: 0;
                        right: 0;
                        bottom: 24px;
                        display: flex;
                        justify-content: center;
                        z-index: 100;
                        pointer-events: none;
                    }

                    .toast-pill {
                        background: var(--ko-ink);
                        color: #fff;
                        font-size: 13.5px;
                        font-weight: 500;
                        padding: 11px 20px;
                        border-radius: 999px;
                        animation: pop 200ms ease;
                    }

                    .kds-bottom-nav {
                        position: fixed;
                        left: 0;
                        right: 0;
                        bottom: 0;
                        z-index: 50;
                        display: flex;
                        padding: 6px 8px calc(8px + env(safe-area-inset-bottom));
                        background: #fff;
                        border-top: 1px solid #edf1f1;
                    }

                    .kds-bottom-nav a {
                        flex: 1;
                        padding: 7px 4px;
                        color: var(--ko-muted);
                        text-align: center;
                        text-decoration: none;
                        border-radius: 12px;
                    }

                    .kds-bottom-nav a.active {
                        color: var(--ko-primary-dark);
                        background: var(--ko-primary-soft);
                        font-weight: 600;
                    }

                    .kds-bottom-nav small { display: block; font-size: 10px; font-weight: 400; }
                </style>
            </head>
            <body>
                <div id="kds-bus-bridge" hidden="hidden" t-att-data-channel="'ko_pos_kds_%s' % (pos_config.id if pos_config else 0)"/>
                <header>
                    <div class="header-top">
                        <div class="header-title">
                            จอครัว <span t-if="pos_config" class="kds-shop-name" t-esc="pos_config.display_name"/>
                            <span t-if="station" class="kds-shop-name" t-esc="station.name"/>
                            <span t-if="not station">· ทุกสถานี</span>
                            <span t-if="not pos_config">· Kitchen display</span>
                        </div>
                        <div class="header-meta">
                            <span id="sla-label">SLA กำลังโหลด…</span>
                            <span class="clock" id="clock">--:--</span>
                        </div>
                    </div>

                    <div class="kds-tabs">
                        <button class="kds-tab-btn active" id="tab-active" onclick="kdsSetTab('active')">
                            กำลังทำ (<span id="active-count">0</span>)
                        </button>
                        <button class="kds-tab-btn" id="tab-served" onclick="kdsSetTab('served')">
                            เสิร์ฟแล้ว
                        </button>
                        <button class="kds-tab-btn" id="tab-cancelled" onclick="kdsSetTab('cancelled')">
                            ยกเลิก
                        </button>
                    </div>

                    <div class="kds-subcontrols" id="subcontrols">
                        <div class="kds-view-toggle">
                            <button class="kds-view-btn active" id="view-order" onclick="kdsSetView('order')">แบบออเดอร์</button>
                            <button class="kds-view-btn" id="view-menu" onclick="kdsSetView('menu')">แบบเมนู</button>
                        </div>
                    </div>

                    <!--
                      One station control only. Until 19.0.6.0.0 this page carried
                      two: hard-coded ครัวร้อน/ครัวเย็น/เครื่องดื่ม chips that filtered
                      in the browser, plus these links that filter on the server by
                      ko.kds.station. They disagreed with each other. The chips are gone.
                    -->
                    <div t-if="stations or len(all_configs) &gt; 1" class="kds-scope-bar">
                        <t t-if="stations">
                            <span class="kds-scope-label">สถานี:</span>
                            <a class="kds-scope-chip" t-att-class="'kds-scope-chip active' if not station else 'kds-scope-chip'"
                               t-att-href="'/kds/pos/%s' % pos_config.id">ทั้งหมด</a>
                            <t t-foreach="stations" t-as="stn">
                                <a class="kds-scope-chip"
                                   t-att-class="'kds-scope-chip active' if station and stn.id == station.id else 'kds-scope-chip'"
                                   t-att-href="'/kds/pos/%s?station_id=%s' % (pos_config.id, stn.id)"
                                   t-esc="stn.name"/>
                            </t>
                        </t>
                        <t t-if="len(all_configs) &gt; 1">
                            <span class="kds-scope-label">ร้าน:</span>
                            <t t-foreach="all_configs" t-as="cfg">
                                <a class="kds-scope-chip"
                                   t-att-class="'kds-scope-chip active' if cfg.id == pos_config.id else 'kds-scope-chip'"
                                   t-att-href="'/kds/pos/%s' % cfg.id"
                                   t-esc="cfg.display_name"/>
                            </t>
                        </t>
                    </div>
                </header>

                <main id="board">
                    <div class="empty-board">กำลังโหลดรายการครัว…</div>
                </main>

                <div class="toast-container" id="toast-wrap" style="display:none;">
                    <div class="toast-pill" id="toast-msg"></div>
                </div>

                <!-- แจ้งปัญหากลับหน้าร้าน: ของหมด / ล่าช้า / ขอเปลี่ยน / อื่น ๆ -->
                <div class="issue-backdrop" id="issue-backdrop" style="display:none;">
                    <div class="issue-sheet" id="issue-sheet">
                        <h3>แจ้งปัญหาให้หน้าร้าน</h3>
                        <div class="issue-sub" id="issue-target">—</div>
                        <div class="issue-opts">
                            <button type="button" class="issue-opt" data-issue="out_of_stock">ของหมด</button>
                            <button type="button" class="issue-opt" data-issue="delay">ล่าช้า</button>
                            <button type="button" class="issue-opt" data-issue="substitute">ขอเปลี่ยนรายการ</button>
                            <button type="button" class="issue-opt" data-issue="other">อื่น ๆ</button>
                        </div>
                        <input type="text" class="issue-note-input" id="issue-note"
                               maxlength="250" placeholder="รายละเอียดเพิ่มเติม (ไม่บังคับ) เช่น เหลือ 1 ที่, รออีก 10 นาที"/>
                        <div class="issue-actions">
                            <button type="button" class="issue-cancel" id="issue-cancel">ยกเลิก</button>
                            <button type="button" class="issue-send" id="issue-send" disabled="disabled">ส่งให้หน้าร้าน</button>
                        </div>
                    </div>
                </div>

                <nav t-if="pos_config" class="kds-bottom-nav" aria-label="เมนูหลัก">
                    <a t-att-href="'/pos/ui/%s' % pos_config.id">ขาย<small>Sell</small></a>
                    <a t-att-href="'/pos/ui/%s/ticket' % pos_config.id">บิล<small>Orders</small></a>
                    <a t-att-href="'/kds/pos/%s' % pos_config.id" class="active">ครัว<small>Kitchen</small></a>
                </nav>

                <script>
                    window.KDS_CONFIG_ID = <t t-esc="pos_config.id if pos_config else 0"/>;
                    window.KDS_STATION_ID = <t t-esc="station.id if station else 0"/>;
                    window.KDS_CSRF = "<t t-esc="csrf_token"/>";
                </script>
                <!-- This script is served directly rather than through an Odoo asset
                     bundle. Keep a version query so browsers cannot reuse an older KDS
                     runtime after an addon upgrade. -->
                <script src="/ko_pos_kds/static/src/kds/kds.js?v=19.0.6.0.0"/>
            </body>
        </html>
    </template>

    <template id="kds_choose_page" name="KDS — เลือกร้าน">
        <html>
            <head>
                <meta charset="utf-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1"/>
                <title>เลือกร้าน · KO KDS</title>
                <style>
                    :root {
                        --ko-primary: oklch(0.5 0.15 190);
                        --ko-primary-dark: oklch(0.4 0.15 190);
                        --ko-primary-soft: oklch(0.5 0.15 190 / 0.07);
                        --ko-ink: #1c2426;
                        --ko-muted: #8fa0a3;
                        --ko-border: #e4ebeb;
                        --ko-canvas: #f7fafa;
                    }
                    * { box-sizing: border-box; }
                    body {
                        margin: 0;
                        font-family: "Prompt", "Noto Sans Thai", system-ui, sans-serif;
                        background: var(--ko-canvas);
                        color: var(--ko-ink);
                        min-height: 100vh;
                        padding: 32px 20px;
                    }
                    .wrap { max-width: 760px; margin: 0 auto; }
                    h1 { font-size: 24px; margin: 0 0 4px; }
                    .sub { color: var(--ko-muted); font-size: 14px; margin: 0 0 24px; }
                    .grid {
                        display: grid;
                        grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
                        gap: 12px;
                    }
                    .shop {
                        display: block;
                        text-decoration: none;
                        color: inherit;
                        background: #fff;
                        border: 1.5px solid var(--ko-border);
                        border-radius: 14px;
                        padding: 18px 18px 16px;
                    }
                    .shop:hover { border-color: var(--ko-primary); background: var(--ko-primary-soft); }
                    .shop-name { font-size: 18px; font-weight: 600; }
                    .shop-company { font-size: 13px; color: var(--ko-muted); margin-top: 2px; }
                    .shop-go { font-size: 13px; font-weight: 600; color: var(--ko-primary-dark); margin-top: 12px; }
                    .empty {
                        background: #fff;
                        border: 1.5px dashed var(--ko-border);
                        border-radius: 14px;
                        padding: 28px;
                        text-align: center;
                        color: var(--ko-muted);
                    }
                </style>
            </head>
            <body>
                <div class="wrap">
                    <h1>เลือกร้านสำหรับจอครัว</h1>
                    <p class="sub">จอครัวแต่ละเครื่องจะแสดงเฉพาะออเดอร์ของร้านที่เลือก · บันทึกหน้านี้เป็นบุ๊กมาร์กของเครื่องนั้นได้เลย</p>
                    <div t-if="configs" class="grid">
                        <a t-foreach="configs" t-as="cfg" class="shop" t-att-href="'/kds/pos/%s' % cfg.id">
