#. module: google_gmail
#: model:ir.model,name:google_gmail.model_res_config_settings
msgid "Config Settings"
msgstr "ตั้งค่าการตั้งค่า"

#. module: google_gmail
#. odoo-python
#: code:addons/google_gmail/models/ir_mail_server.py:0
msgid ""
"Incorrect Connection Security for Gmail mail server “%s”. Please set it to "
"\"TLS (STARTTLS)\"."
msgstr ""
"การรักษาความปลอดภัยการเชื่อมต่อสำหรับเซิร์ฟเวอร์อีเมล Gmail “%s” ไม่ถูกต้อง "
"กรุณาตั้งค่าเป็น \"TLS (STARTTLS)\""

#. module: google_gmail
#. odoo-python
#: code:addons/google_gmail/models/google_gmail_mixin.py:0
msgid "Please configure your Gmail credentials."
msgstr "กรุณาตั้งค่าข้อมูลรับรอง Gmail ของคุณ"

#. module: google_gmail
#. odoo-python
#: code:addons/google_gmail/models/ir_mail_server.py:0
msgid ""
"Please leave the password field empty for Gmail mail server “%s”. The OAuth "
"process does not require it"
msgstr ""
"กรุณาเว้นฟิลด์รหัสผ่านว่างไว้สำหรับเซิร์ฟเวอร์อีเมล Gmail “%s” กระบวนการ "
"OAuth ไม่จำเป็นต้องใช้"
