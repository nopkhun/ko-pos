#. module: account_payment
#: model_terms:ir.ui.view,arch_db:account_payment.payment_refund_wizard_view_form
msgid ""
"<strong>Warning!</strong> There is a refund pending for this payment.\n"
"                        Wait a moment for it to be processed. If the refund is still pending in a\n"
"                        few minutes, please check your payment provider configuration."
msgstr ""
"<strong>คำเตือน!</strong> มีการคืนเงินที่รอดำเนินการสำหรับการชำระเงินนี้\n"
"                        รอสักครู่เพื่อให้ดำเนินการ หากการคืนเงินยังรอดำเนินการในอีกไม่กี่นาที\n"
"                        กรุณาตรวจสอบการตั้งค่าผู้ให้บริการชำระเงินของคุณ"

#. module: account_payment
#: model:ir.model.fields,field_description:account_payment.field_payment_link_wizard__invoice_amount_due
msgid "Amount Due"
msgstr "จำนวนที่ค้างชำระ"

#. module: account_payment
#: model:ir.model,name:account_payment.model_res_config_settings
msgid "Config Settings"
msgstr "ตั้งค่าการตั้งค่า"

#. module: account_payment
#: model_terms:ir.ui.view,arch_db:account_payment.portal_my_home_overdue_invoice
msgid "Invoices &amp; Bills"
msgstr "ใบแจ้งหนี้และบิลซื้อ"

#. module: account_payment
#: model:ir.model,name:account_payment.model_account_journal
msgid "Journal"
msgstr "สมุดบัญชี"

#. module: account_payment
#: model:ir.model,name:account_payment.model_account_move
msgid "Journal Entry"
msgstr "รายการสมุดบัญชี"

#. module: account_payment
#: model:ir.model.fields,help:account_payment.field_account_payment__payment_token_id
msgid ""
"Note that only tokens from providers allowing to capture the amount are "
"available."
msgstr ""
"กรุณาทราบว่ามีเพียงโทเค็นจากผู้ให้บริการที่อนุญาตให้บันทึกจำนวนเงินที่มีอยู่เท่านั้น"

#. module: account_payment
#: model:ir.model.fields,help:account_payment.field_account_payment_register__payment_token_id
msgid ""
"Note that tokens from providers set to only authorize transactions (instead "
"of capturing the amount) are not available."
msgstr ""
"กรุณาทราบว่าโทเค็นจากผู้ให้บริการที่ตั้งค่าให้อนุญาตเฉพาะธุรกรรม "
"(แทนที่จะบันทึกจำนวนเงิน) จะไม่สามารถใช้ได้"

#. module: account_payment
#: model:ir.model.fields,field_description:account_payment.field_payment_provider__journal_id
msgid "Payment Journal"
msgstr "สมุดบัญชีชำระเงิน"

#. module: account_payment
#: model:ir.model.fields,help:account_payment.field_payment_provider__journal_id
msgid "The journal in which the successful transactions are posted."
msgstr "สมุดบัญชีที่มีลงบัญชีธุรกรรมที่สำเร็จ"

#. module: account_payment
#. odoo-python
#: code:addons/account_payment/models/account_journal.py:0
msgid ""
"You must first deactivate a payment provider before deleting its journal.\n"
"Linked providers: %s"
msgstr ""
"คุณต้องปิดการใช้งานผู้ให้บริการชำระเงินก่อน จึงจะลบสมุดบัญชีได้\n"
"ผู้ให้บริการที่เชื่อมโยง: %s"
