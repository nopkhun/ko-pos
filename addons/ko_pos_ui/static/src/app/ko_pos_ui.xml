<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="ko_pos_ui.ProductScreen"
       t-inherit="point_of_sale.ProductScreen"
       t-inherit-mode="extension">
        <xpath expr="//div[hasclass('product-screen')]" position="attributes">
            <attribute name="class" add="ko-pos-product-screen" separator=" "/>
        </xpath>
        <xpath expr="//div[hasclass('leftpane')]/OrderSummary" position="before">
            <div class="ko-order-heading d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center gap-2">
                    <span class="ko-step-badge">1</span>
                    <strong>ออเดอร์ปัจจุบัน</strong>
                </div>
                <small class="text-muted">ตรวจรายการก่อนชำระเงิน</small>
            </div>
        </xpath>
        <xpath expr="//div[hasclass('rightpane')]/div[hasclass('position-relative')]/CategorySelector" position="before">
            <div class="ko-menu-heading d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center gap-2">
                    <span class="ko-step-badge">2</span>
                    <strong>เลือกเมนู</strong>
                </div>
                <small class="text-muted">แตะรายการเพื่อเพิ่มลงออเดอร์</small>
            </div>
        </xpath>
    </t>

    <t t-name="ko_pos_ui.ProductCard"
       t-inherit="point_of_sale.ProductCard"
       t-inherit-mode="extension">
        <xpath expr="//article" position="attributes">
            <attribute name="class" add="ko-product-card" separator=" "/>
        </xpath>
        <xpath expr="//div[hasclass('product-content')]" position="inside">
            <span t-if="this.koDisplayPrice"
                  class="ko-product-price ms-auto align-self-end fw-bold text-nowrap"
                  t-esc="this.koDisplayPrice"/>
        </xpath>
    </t>
</templates>
